// Use the user variables to set what devices we are looking at the processes for, limit the scope based on time, and toggle filtering out if it was an operating system account that initiated the process
let userDevice = pack_array("");
let timeframe = ago(7d);
let queryTime = ago(60d);
let filterOutOSAccounts = true;
let maxDeviceCount = 10;
//
// Filter for any action that has to do with a scheduled task on specified devices
DeviceEvents
| where TimeGenerated >= queryTime
| where ActionType in~ ("ScheduledTaskCreated", "ScheduledTaskRegistered", "ScheduledTaskDeleted", "ScheduledTaskUpdated", "ScheduledTaskExecuted", "ScheduledTaskLaunched", "ScheduledTaskEnabled", "ScheduledTaskDisabled")
| where filterOutOSAccounts == false or (filterOutOSAccounts == true and InitiatingProcessAccountSid != "S-1-5-18") // Filter out any initiating accounts that have an SID that is exactly S-1-5-18 as these are special accounts used by the operating system
//
| extend AdditionalFields = parse_json(AdditionalFields)
| evaluate bag_unpack(AdditionalFields)
//
| extend TaskContent = parse_json(TaskContent)
| evaluate bag_unpack(TaskContent, "Task_")
//
| extend Task_Actions = parse_json(Task_Actions)
| evaluate bag_unpack(Task_Actions, "Action_")
//
| extend Task_Triggers = parse_json(Task_Triggers)
| evaluate bag_unpack(Task_Triggers, "Trigger_")
//
| extend Action_Exec = parse_json(Action_Exec)
| evaluate bag_unpack(Action_Exec, "Exec_")
| extend TargetDevices = iif(DeviceName has_any(userDevice), DeviceName, "")
| summarize TaskCount = count(), Devices = make_set(DeviceName), TargetDevices = make_set(TargetDevices), Accounts = make_set(InitiatingProcessAccountName), AccountSIDs = make_set(InitiatingProcessAccountSid), Executables = make_set(Exec_Command), StartTimes = make_set(TimeGenerated), ExeArgs = make_set(Exec_Arguments), MostRecentStart = max(TimeGenerated) by TaskName, ActionType
| extend DeviceCount = array_length(Devices)
| where DeviceCount <= maxDeviceCount
//
// Filter for commands that were enacted on the device being searched for
| where Devices has_any(userDevice)
| where MostRecentStart >= timeframe
//
| where
    // Filtering out the Google Updater
    (not(TaskName startswith @"\GoogleUser\GoogleUpdater\GoogleUpdaterTaskUser"
        and ActionType == "ScheduledTaskCreated"
        and Executables has_all('AppData\\Local\\Google\\GoogleUpdater', 'updater.exe')))
    and (not(TaskName startswith @"\GoogleUser\GoogleUpdater\GoogleUpdaterTaskUser"
        and ActionType == "ScheduledTaskDeleted"))
    //
    // Filtering out the Experience Helper for Chrome
    and (not(Executables has_any("Google\\Chrome\\Application\\PlatformExperienceHelper\\platform_experience_helper.exe")
        and (TaskName == @"\GoogleUserPEH\RunPlatformExperienceHelper_CheckEligible" or TaskName == @"\GoogleUserPEH\RunPlatformExperienceHelper_Metrics" or TaskName == @"\GoogleUserPEH\RunPlatformExperienceHelper_DeleteShortcut" or TaskName == @"\GoogleUserPEH\RunPlatformExperienceHelperOnUnlock" or TaskName == @"\GoogleUserPEH\RunPlatformExperienceHelper_FirstRun" or TaskName == @"\GoogleUserPEH\RunPlatformExperienceHelper")
