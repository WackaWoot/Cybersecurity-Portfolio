        and ActionType == "ScheduledTaskDeleted"))
    //
    // Filtering out Zoom Updates
    and (not((TaskName startswith @"\ZoomUpdateTaskUser-S-1-5-21" or TaskName startswith @"\ZoomUpdateTaskUser-S-1-12-1")
        and ActionType == "ScheduledTaskCreated"
        and Executables has_any('AppData\\Roaming\\Zoom\\bin\\Zoom.exe')))
    and (not((TaskName startswith @"\ZoomUpdateTaskUser-S-1-5-21" or TaskName startswith @"\ZoomUpdateTaskUser-S-1-12-1")
