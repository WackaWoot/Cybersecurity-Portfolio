    and (not(TaskName startswith @"\OneDrive Reporting Task"
        and ActionType == "ScheduledTaskCreated"
        and Executables has_any("%localappdata%\\Microsoft\\OneDrive\\OneDriveStandaloneUpdater.exe", "C:\\Program Files (x86)\\Microsoft OneDrive\\OneDriveStandaloneUpdater.exe", "C:\\Program Files\\Microsoft OneDrive\\OneDriveStandaloneUpdater.exe")))
    and (not(TaskName startswith @"\OneDrive Startup Task"
        and ActionType == "ScheduledTaskUpdated"
        and Executables has_all("\\AppData\\Local\\Microsoft\\OneDrive\\", "\\OneDriveLauncher.exe")))
    and (not(TaskName startswith @"\OneDrive Reporting Task"
        and ActionType == "ScheduledTaskUpdated"
        and Executables has_any("%localappdata%\\Microsoft\\OneDrive\\OneDriveStandaloneUpdater.exe")))
    and (not(TaskName startswith @"\OneDrive Standalone Update Task"
        and ActionType == "ScheduledTaskDeleted"))
    //
    // Filtering out Internet Explorer's Sync task
    and (not(TaskName startswith @"\User_Feed_Synchronization-"
        and ActionType == "ScheduledTaskUpdated"
        and Executables has_any("C:\\WINDOWS\\system32\\msfeedssync.exe")))
    //
    // Filtering out w11-oms-vdi-01 processes for OMS
    and (not(TaskName has_any("\\RAD Muni Incident Update - PROD new", "\\RAD Outage Counts - PROD new", "\\Avineonics AGOL new", "\\Avineonics AGOL new", "\\CH_DEVICE_LAT_LONG Refresh new", "\\EORS Outage Report new", "\\EORS Outage Report new", "\\RAD 511 DA - PROD new", "\\RAD ETR - PROD new", "\\RAD Muni Incident Update - PROD new", "\\RAD Outage Counts - PROD new", "\\UALBANY OUTAGE FILE FEED - PROD new", "\\UALBANY OUTAGE FILE FEED - PROD new")
        and ActionType has_any("ScheduledTaskUpdated", "ScheduledTaskCreated")
        and Executables has_any("cmd.exe")))
    //
    // Filtering out Adobe
    and (not(TaskName ==  @"\Launch Adobe CCXProcess"
        and ActionType == "ScheduledTaskUpdated"
        and Executables has_any("C:\\Program Files\\Adobe\\Adobe Creative Cloud Experience\\CCXProcess.exe")))
    //
    // Filtering out Edge Updates
    and (not(TaskName startswith  @"\MicrosoftEdgeUpdateTaskUserS-1-5-21"
        and (ActionType == "ScheduledTaskUpdated" or ActionType == "ScheduledTaskCreated")
        and Executables has_any("\\AppData\\Local\\Microsoft\\EdgeUpdate\\MicrosoftEdgeUpdate.exe")))
    //
    // Filtering out Mozilla Updates
    and (not(TaskName startswith  @"\Mozilla\Firefox Background Update S-1-5-21"
        and (ActionType == "ScheduledTaskUpdated" or ActionType == "ScheduledTaskCreated")
        and Executables has_any("C:\\Program Files\\Mozilla Firefox\\firefox.exe")))
    and (not(TaskName startswith  @"\Mozilla\Firefox Background Update S-1-5-21"
        and ActionType == "ScheduledTaskDeleted"))
    and (not(TaskName startswith  @"\Mozilla\Firefox Background Update S-1-5-21"
        and (ActionType == "ScheduledTaskUpdated" or ActionType == "ScheduledTaskCreated")
        and Executables has_any("\\AppData\\Local\\Mozilla Firefox\\firefox.exe")))
    //
    // Filtering out PowerToys
    and (not(TaskName startswith  @"\PowerToys\Autorun for "
        and ActionType == "ScheduledTaskCreated"
        and Executables has_any("\\AppData\\Local\\PowerToys\\PowerToys.exe")))
    and (not(TaskName startswith  @"\PowerToys\Autorun for "
        and ActionType == "ScheduledTaskDeleted"))
    //
    // Filtering out ArcGIS
    and (not(TaskName startswith  @"\ArcGIS Pro Indexing ("
        and ActionType == "ScheduledTaskCreated"
        and Executables has_any("C:\\Program Files\\ArcGIS\\Pro\\bin\\ArcGISIndexingServer.exe")))
    and (not(TaskName startswith  @"\ArcGIS Pro Indexing ("
        and ActionType == "ScheduledTaskDeleted"))
//
//
| sort by DeviceCount desc, TaskCount desc, TaskName asc
| project-reorder TargetDevices, Devices, DeviceCount, ActionType, TaskName, Executables, ExeArgs, TaskCount, Accounts, AccountSIDs


