// Uncommon TLD web comms (allowlist common TLDs; surface everything else)
let CommonTLDs = dynamic([
  "com","net","org","edu","gov","mil",
  "io","co","us","uk","ca","au","de","fr","jp","in","cn","ru","br","it","es","nl","se","no","fi","dk","ch","at","ie","nz",
  "info","biz","app","dev","cloud","site","online","store","shop","blog","news","media","live",
  "azure","microsoft","office","sharepoint"
]);
//
DeviceNetworkEvents
| where Timestamp > ago(7d)
| where ActionType in ("ConnectionSuccess", "ConnectSuccess", "ConnectionAttempt")
| where isnotempty(RemoteUrl)
// normalize / extract host
| extend RemoteUrlLower = tolower(RemoteUrl)
| extend Host = tolower(tostring(parse_url(RemoteUrlLower).Host))
| extend Host = iff(isempty(Host), RemoteUrlLower, Host)
| extend Host = tostring(split(Host, ":")[0])
| where isnotempty(Host)
// FIX: replace invalid "!matches" with not(matches regex)
| where not(Host matches regex @"^\d{1,3}(\.\d{1,3}){3}$")
// Pull last label as TLD (simple heuristic)
| extend Labels = split(Host, ".")
| where array_length(Labels) >= 2
| extend TLD = tostring(Labels[array_length(Labels)-1])
// Filter out common TLDs
| where TLD !in~ (CommonTLDs)
// Optional: exclude local/internal suffixes if present in your environment
| where TLD !in~ ("local","lan","internal")
| project
    Timestamp,
    DeviceName,
    InitiatingProcessAccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    RemoteUrl,
    Host,
    TLD,
    RemoteIP,
    RemotePort,
    Protocol
| summarize
    FirstSeen=min(Timestamp),
    LastSeen=max(Timestamp),
    ConnCount=count(),
    Devices=dcount(DeviceName),
    Accounts=dcount(InitiatingProcessAccountName)
  by TLD, Host, RemoteUrl, RemoteIP, InitiatingProcessFileName
| order by ConnCount desc, LastSeen desc


