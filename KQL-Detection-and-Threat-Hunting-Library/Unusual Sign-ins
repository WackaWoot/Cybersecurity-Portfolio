let timeframe = ago(60d);
//
// Search IdentityLogonEvents for the user signins within the timeframe specified
let userLoginsILE = IdentityLogonEvents
| where TimeGenerated >= timeframe
| where DeviceName !contains "adfs" and DeviceName != "" and IPAddress !startswith "10." and IPAddress != "FirewallIP"
| project TimeGenerated, ActionType, DeviceName, AccountName, IPAddress, LogonType;
//
// Store the IP addresses of the IdentityLogonEvents query
let ipaddrs = userLoginsILE
| project IPAddress;
//
// Cross reference the logins found in IdentityLogonEvents with SigninLogs and find any unique IPs in SigninLogs
SigninLogs
| where TimeGenerated >= timeframe
| where IPAddress !in (ipaddrs) and IPAddress !startswith "10." and IPAddress != "FirewallIP" // filter out IP addresses that are already accounted for in IdentityLogonEvents so we do not have duplicate records
| project TimeGenerated, ActionType = ResultSignature, LogonType = AppDisplayName, AccountName = UserPrincipalName, IPAddress, LocationDetails//, City, State, CountryRegion
| union userLoginsILE
| where AccountName != "" and IPAddress != ""
| extend City = tostring(LocationDetails["city"]), State = tostring(LocationDetails["state"]), CountryRegion = tostring(LocationDetails["countryOrRegion"])
| summarize FirstTime = min(TimeGenerated), LastTime = max(TimeGenerated), Actions = make_set(ActionType), Count = count(), Successes = countif(ActionType has_any ("Success", "LogonSuccess")), Failures = countif(ActionType has_any ("Failure", "LogonFailed")) by IPAddress, City, State, CountryRegion, LogonType, AccountName
| where Actions has_any ("LogonSuccess", "SUCCESS")
// | sort by AccountName asc, Count desc
| sort by Successes asc, Failures asc



