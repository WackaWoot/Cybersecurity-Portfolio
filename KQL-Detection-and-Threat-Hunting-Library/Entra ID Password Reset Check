AuditLogs //Checks logs for password resets on accounts that only exist in Entra.
| where OperationName == "Change user password"
| where TargetResources contains "username" //EntraAD username should be placed here
| extend TargetResources = tostring(parse_json(TargetResources)[0].userPrincipalName)
| extend InitiatedBy = tostring(parse_json(InitiatedBy).app.displayName)
| project TimeGenerated, OperationName, Identity, InitiatedBy, Result, TargetResources, ActivityDisplayName, ActivityDateTime
