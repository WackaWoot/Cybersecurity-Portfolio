//Horizontal bar chart version
 
DeviceNetworkEvents
| extend ParsedUrl = parse_url(RemoteUrl)
| extend Domain = tostring(ParsedUrl["Host"])
| where isnotempty(Domain)
| where Domain !in ("googleapis.com", "in-addr.arpa")
| extend Extension = strcat(".", tolower(extract(@"\.([a-z]{2,})$", 1, Domain)))
| where isnotempty(Extension) and Extension != "."
| where Extension !in (".com", ".net", ".org", ".gov", ".us")
| summarize Count = count() by Extension
| top 15 by Count desc
| render barchart kind= stacked
 
