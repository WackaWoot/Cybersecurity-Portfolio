// Searches IdentityDirectoryEvents and AuditLogs for password changes for a specified user within a timeframe
// Initializing the user and timeframe being searched within
let user = "username";
let timeframe = ago(60d);
//
// Search IdentityDirectoryEvents for password changes
let IDEpwdResets = IdentityDirectoryEvents //Checks MDI for AD events indicating password reset, NOTE: This will not populate any events for Entra only accounts 
| where TimeGenerated >= timeframe
| where TargetAccountUpn contains user
| where ActionType == "Account Password changed"
| project TimeGenerated, ActionType, TargetAccountDisplayName, TargetAccountUpn, Actor = AccountUpn;
// 
// Search AuditLogs for password changes (Entra only accounts)
AuditLogs //Checks logs for password resets on accounts that only exist in Entra.
| where TimeGenerated >= timeframe
| where TargetResources contains user
| where OperationName == "Change user password"
//
// Parse out the name of the account and who changed the password
| extend TargetAccountUpn = tostring(parse_json(TargetResources)[0].userPrincipalName)
| extend InitiatedBy = tostring(parse_json(InitiatedBy).app.displayName)
| extend AccountType = "Entra only account"
| project TimeGenerated, ActionType = OperationName, Identity, InitiatedBy, Result, TargetAccountUpn, AccountType
//
// Combine this with the entries filtered for in IdentityDirectoryEvents to display all password changes
| union IDEpwdResets
| project-reorder TimeGenerated, ActionType, AccountType, TargetAccountUpn, Actor, Result, InitiatedBy
| sort by TimeGenerated desc
